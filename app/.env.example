# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string, e.g. from Render or HostPinnacle
DATABASE_URL=postgres://user:password@host:5432/invoicing

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# "development" or "production" — controls secure cookies etc.
NODE_ENV=development

PORT=3000

# Emails used for the three seeded accounts (change before running seed)
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_MANAGER_EMAIL=manager@yourcompany.com
SEED_CLERK_EMAIL=clerk@yourcompany.com
