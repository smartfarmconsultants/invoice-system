<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Invoice <%= invoice.invoice_number %></title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/logo-icon.png" />
</head>
<body>
  <%- include('_topbar', { user }) %>
  <main>
    <img src="/letterhead.png" alt="Company letterhead" style="max-width:100%; margin-bottom:20px;" />
    <h2>Invoice <%= invoice.invoice_number %></h2>
    <p style="color:#5c6570; font-size:0.85rem;"><%= reference.displayText %></p>

    <a class="btn" href="/invoices/<%= invoice.id %>/pdf">Download PDF</a>
    <% if (user.role === 'admin' || user.role === 'manager') { %>
      <a class="btn secondary" href="/invoices/<%= invoice.id %>/edit">Edit Invoice</a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <form method="POST" action="/invoices/<%= invoice.id %>/delete" style="display:inline"
        onsubmit="return confirm('Delete invoice <%= invoice.invoice_number %>? This is permanent and cannot be undone.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn secondary" style="background:#b3261e;">Delete Invoice</button>
      </form>
    <% } %>

    <div class="card" style="margin-top:20px;">
      <p><strong>Customer:</strong> <%= invoice.customer_name %></p>
      <p><strong>Date:</strong> <%= new Date(invoice.invoice_date).toLocaleDateString() %>
         &nbsp; <strong>Due:</strong> <%= invoice.due_date ? new Date(invoice.due_date).toLocaleDateString() : '-' %></p>

      <% if (user.role === 'admin' || user.role === 'manager') { %>
        <form method="POST" action="/invoices/<%= invoice.id %>/status" style="margin:8px 0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label style="display:inline; margin-right:8px;"><strong>Status:</strong></label>
          <select name="status" onchange="this.form.submit()">
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= invoice.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }) %>
          </select>
        </form>
      <% } else { %>
        <p><strong>Status:</strong> <%= invoice.status %></p>
      <% } %>

      <table>
        <thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th>Amount</th></tr></thead>
        <tbody>
        <% items.forEach(it => { %>
          <tr>
            <td><%= it.description %></td>
            <td><%= it.quantity %></td>
            <td><%= Number(it.unit_price).toLocaleString() %></td>
            <td><%= Number(it.amount).toLocaleString() %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>

      <p style="text-align:right; margin-top:16px;">
        Subtotal (excl. VAT): <%= Number(invoice.subtotal).toLocaleString() %><br/>
        VAT: <%= Number(invoice.tax).toLocaleString() %><br/>
        <% if (Number(invoice.discount || 0) > 0) { %>
          Total (VAT inclusive): <%= Number(invoice.total).toLocaleString() %><br/>
          Discount: -<%= Number(invoice.discount).toLocaleString() %><br/>
          <strong>Amount Due: <%= reference.amountDue.toLocaleString() %></strong>
        <% } else { %>
          <strong>Total (VAT inclusive): <%= Number(invoice.total).toLocaleString() %></strong>
        <% } %>
      </p>
    </div>
  </main>
  <%- include('_footer') %>
</body>
</html>
