<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Change Password — Invoice System</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="auth-wrap">
    <h2>Set a New Password</h2>
    <p style="color:#5c6570; font-size:0.9rem;">
      Must be at least 8 characters and include at least one uppercase letter, one lowercase letter,
      one number, and one symbol (e.g. <code>!@#$%</code>). Longer is stronger — feel free to use a passphrase.
    </p>
    <div class="card">
      <form method="POST" action="/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>New Password</label>
        <div class="password-field">
          <input
            id="newPassword"
            type="password"
            name="newPassword"
            minlength="8"
            maxlength="64"
            pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&amp;*()\-_=+\[\]{};:'&quot;,.&lt;&gt;/?\\|`~]).{8,64}$"
            title="At least 8 characters, with at least one uppercase letter, one lowercase letter, one number, and one symbol"
            required
          />
          <button type="button" class="toggle-visibility" data-target="newPassword" aria-label="Show password">Show</button>
        </div>

        <label>Confirm New Password</label>
        <div class="password-field">
          <input
            id="confirmPassword"
            type="password"
            name="confirmPassword"
            minlength="8"
            maxlength="64"
            required
          />
          <button type="button" class="toggle-visibility" data-target="confirmPassword" aria-label="Show password">Show</button>
        </div>

        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <button type="submit">Update Password</button>
      </form>
    </div>
  </div>

  <script>
    document.querySelectorAll('.toggle-visibility').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.textContent = showing ? 'Show' : 'Hide';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });
  </script>
  <%- include('_footer') %>
</body>
</html>
