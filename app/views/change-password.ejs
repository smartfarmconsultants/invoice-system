<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Change Password — Invoice System</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="auth-wrap">
    <h2>Set a New Password</h2>
    <p style="color:#5c6570; font-size:0.9rem;">For security, you must set your own password before continuing.</p>
    <div class="card">
      <form method="POST" action="/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>New Password (min. 10 characters)</label>
        <input type="password" name="newPassword" minlength="10" required />
        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" minlength="10" required />
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <button type="submit">Update Password</button>
      </form>
    </div>
  </div>
  <%- include('_footer') %>
</body>
</html>
