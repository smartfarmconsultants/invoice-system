<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title><%= invoice ? 'Edit Invoice ' + invoice.invoice_number : 'New Invoice' %> — Invoice System</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/logo-icon.png" />
</head>
<body>
  <%- include('_topbar', { user }) %>
  <main>
    <h2><%= invoice ? 'Edit Invoice ' + invoice.invoice_number : 'New Invoice' %></h2>
    <div class="card">
      <form method="POST" action="<%= invoice ? '/invoices/' + invoice.id + '/edit' : '/invoices' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>Customer</label>
        <select name="customer_id" required>
          <% customers.forEach(c => { %>
            <option value="<%= c.id %>" <%= invoice && invoice.customer_id === c.id ? 'selected' : '' %>><%= c.customer_name %></option>
          <% }) %>
        </select>

        <label>Invoice Date</label>
        <input type="date" name="invoice_date" required
          value="<%= invoice ? new Date(invoice.invoice_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>" />

        <label>Due Date</label>
        <input type="date" name="due_date" value="<%= invoice && invoice.due_date ? new Date(invoice.due_date).toISOString().slice(0,10) : '' %>" />

        <label>VAT Rate (%) — already included in each unit price below, not added on top</label>
        <%
          // On edit, back-derive the rate that was used originally from the
          // stored subtotal/tax so the field doesn't just silently reset.
          // On create, use the admin-configured default from Settings.
          let defaultRate = typeof defaultTaxRate !== 'undefined' ? defaultTaxRate : 16;
          if (invoice && Number(invoice.subtotal) > 0) {
            defaultRate = Math.round((Number(invoice.tax) / Number(invoice.subtotal)) * 10000) / 100;
          }
        %>
        <input type="number" step="0.01" name="tax_rate" value="<%= defaultRate %>" />

        <label>Discount (KES) — a flat amount, not a percentage, deducted from the total</label>
        <input type="number" step="0.01" min="0" name="discount" value="<%= invoice ? Number(invoice.discount || 0) : 0 %>" />

        <h3 style="margin-top:20px;">Line Items</h3>
        <p style="color:#5c6570; font-size:0.85rem; margin-top:-4px;">
          Enter the price customers actually pay per item (VAT-inclusive). The VAT portion will be
          extracted automatically for the invoice breakdown — it will not be added to your total.
        </p>
        <div id="items">
          <% if (items && items.length > 0) { %>
            <% items.forEach(it => { %>
              <div class="item-row">
                <input type="text" name="descriptions" placeholder="Description" required value="<%= it.description %>" />
                <input type="number" step="0.01" name="quantities" placeholder="Qty" required value="<%= it.quantity %>" />
                <input type="number" step="0.01" name="unit_prices" placeholder="Unit Price" required value="<%= it.unit_price %>" />
                <button type="button" class="remove-row-btn" onclick="removeRow(this)" title="Remove this line">&times;</button>
              </div>
            <% }) %>
          <% } else { %>
            <div class="item-row">
              <input type="text" name="descriptions" placeholder="Description" required />
              <input type="number" step="0.01" name="quantities" placeholder="Qty" required />
              <input type="number" step="0.01" name="unit_prices" placeholder="Unit Price" required />
              <button type="button" class="remove-row-btn" onclick="removeRow(this)" title="Remove this line">&times;</button>
            </div>
          <% } %>
        </div>
        <button type="button" class="btn secondary" onclick="addRow()">+ Add Line</button>
        <br/>
        <button type="submit"><%= invoice ? 'Save Changes' : 'Create Invoice' %></button>
      </form>
    </div>
  </main>
  <script>
    function addRow() {
      const wrap = document.getElementById('items');
      const row = document.createElement('div');
      row.className = 'item-row';
      row.innerHTML = `
        <input type="text" name="descriptions" placeholder="Description" required />
        <input type="number" step="0.01" name="quantities" placeholder="Qty" required />
        <input type="number" step="0.01" name="unit_prices" placeholder="Unit Price" required />
        <button type="button" class="remove-row-btn" onclick="removeRow(this)" title="Remove this line">&times;</button>
      `;
      wrap.appendChild(row);
    }
    function removeRow(button) {
      const wrap = document.getElementById('items');
      // Always keep at least one row — an invoice needs at least one line item.
      if (wrap.children.length <= 1) {
        alert('An invoice needs at least one line item — clear the fields instead of removing the last row.');
        return;
      }
      button.closest('.item-row').remove();
    }
  </script>
  <%- include('_footer') %>
</body>
</html>
