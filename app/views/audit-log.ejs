<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Audit Log — Invoice System</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="/logo-icon.png" />
</head>
<body>
  <%- include('_topbar', { user }) %>
  <main>
    <h2>Audit Log</h2>
    <p style="color:#5c6570; font-size:0.85rem;"><%= totalCount %> event<%= totalCount === 1 ? '' : 's' %> recorded</p>

    <table>
      <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th><th>Details</th></tr></thead>
      <tbody>
      <% entries.forEach(e => { %>
        <tr>
          <td><%= new Date(e.created_at).toLocaleString() %></td>
          <td><%= e.full_name ? e.full_name + ' (' + e.email + ')' : 'Unknown / deleted user' %></td>
          <td><%= e.action %></td>
          <td><%= e.entity_type ? e.entity_type + (e.entity_id ? ' #' + e.entity_id : '') : '-' %></td>
          <td><%= e.ip_address || '-' %></td>
          <td><%= e.details || '-' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top:20px; display:flex; gap:10px; align-items:center;">
        <% if (page > 1) { %>
          <a class="btn secondary" style="margin:0;" href="/audit-log?page=<%= page - 1 %>">← Previous</a>
        <% } %>
        <span style="color:#5c6570; font-size:0.85rem;">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a class="btn secondary" style="margin:0;" href="/audit-log?page=<%= page + 1 %>">Next →</a>
        <% } %>
      </div>
    <% } %>
  </main>
  <%- include('_footer') %>
</body>
</html>
