<div class="topbar">
  <div class="brand">
    <img src="/logo-icon.png" alt="SmartFarm Consultants Kenya" style="height:28px; width:auto; vertical-align:middle; margin-right:8px;" />
    <span style="vertical-align:middle;">Invoice System</span>
  </div>
  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/invoices">Invoices</a>
    <a href="/customers">Customers</a>
    <% if (user.role === 'admin') { %><a href="/users">Users</a><a href="/audit-log">Audit Log</a><a href="/settings">Settings</a><% } %>
    <a href="/change-password">Change Password</a>
    <span class="role-badge"><%= user.fullName %> · <%= user.role %></span>
    <form method="POST" action="/logout" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <a href="#" onclick="this.closest('form').submit(); return false;">Log out</a>
    </form>
  </nav>
</div>
